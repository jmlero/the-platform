FROM golang:1.27.1-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -buildvcs=false -trimpath -o /out/analysis-byo ./cmd/analysis-byo

FROM python:3.13.15-slim-bookworm
COPY harnesses/langchain/requirements.txt /opt/marina-harness/requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /opt/marina-harness/requirements.txt && \
    mkdir -p /work && chown 65532:65532 /work
COPY harnesses/langchain/run.py /opt/marina-harness/run.py
COPY --from=build /out/analysis-byo /analysis-byo
ENV PYTHONDONTWRITEBYTECODE=1 LANGSMITH_TRACING=false LANGCHAIN_TRACING_V2=false \
    SSL_CERT_FILE=/run/kagent/egress/trust-bundle.pem REQUESTS_CA_BUNDLE=/run/kagent/egress/trust-bundle.pem
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/analysis-byo"]
